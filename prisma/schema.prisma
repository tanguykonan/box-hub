// =============================================================================
// PRISMA SCHEMA - BOX HUB PLATFORM (REGISTRY ENGINE)
// =============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum AdminRole {
  OWNER
  ADMINISTRATOR
}

enum UserTier {
  FREE
  TIER_5
  TIER_10
  TIER_20
}

enum RuntimeType {
  PYTHON
  NODEJS
}

enum PackageCategory {
  BOTS
  API
  AI
  TOOLS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

// -----------------------------------------------------------------------------
// 1. AUTHENTIFICATION & IDENTITÉ (NextAuth / Auth.js + PAT CLI)
// -----------------------------------------------------------------------------

model User {
  id            String        @id @default(uuid())
  username      String        @unique
  email         String        @unique
  emailVerified DateTime?
  passwordHash  String?
  avatarUrl     String?
  role          Role          @default(USER)
  tier          UserTier      @default(FREE)
  quotaBytes    BigInt        @default(524288000) // 500 MB quota R2 par défaut
  isBanned      Boolean       @default(false)
  lastLoginAt   DateTime?
  locale        String        @default("fr")

  // Relations Auth & Sessions
  accounts      Account[]
  sessions      Session[]
  apiTokens     ApiToken[]

  // Relations Registre
  packages      Package[]
  stars         PackageStar[]
  collaborations PackageCollaborator[]
  subscriptions Subscription[]
  transactions  PaymentTransaction[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ApiToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String    // ex: "CLI Macbook Pro", "GitHub Actions CI"
  tokenHash   String    @unique
  tokenPrefix String    // ex: "box_pat_9a8f"
  scopes      String[]  // ex: ["packages:read", "packages:write"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?

  createdAt   DateTime  @default(now())

  @@map("api_tokens")
}

// -----------------------------------------------------------------------------
// 2. REGISTRE DES PAQUETS & VERSIONS (.box sur Cloudflare R2)
// -----------------------------------------------------------------------------

model Package {
  id             String          @id @default(uuid())
  name           String
  description    String          @db.Text
  runtime        RuntimeType
  runtimeVersion String          // ex: "3.12", "26.0.0"
  category       PackageCategory
  isPrivate      Boolean         @default(false)
  isProtected    Boolean         @default(false) // Bytecode V8 / .pyc
  tags           String[]        // ex: ["#ai", "#discord", "#bot"]
  license        String?         // ex: "MIT", "Apache-2.0"
  authorId       String
  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  totalDownloads Int             @default(0)

  // Fork auto-référentiel (sans table intermédiaire)
  forkedFromId   String?
  forkedFrom     Package?        @relation("PackageForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks          Package[]       @relation("PackageForks")

  // Relations
  versions       PackageVersion[]
  stars          PackageStar[]
  collaborators  PackageCollaborator[]
  webhooks       PackageWebhook[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([authorId, name])
  @@index([category, runtime])
  @@map("packages")
}

model PackageVersion {
  id             String   @id @default(uuid())
  packageId      String
  package        Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  version        String   // SemVer, ex: "1.0.4"
  tag            String   @default("latest")
  checksumSha256 String   // Hash Fast Integrity
  fileSizeBytes  BigInt   // Taille binaire exacte en octets
  storageKey     String   // Chemin Cloudflare R2
  targetArch     String?  // ex: "universal", "linux-x86_64", "android-aarch64"
  readme         String?  @db.Text
  envVariables   Json?    // Schéma JSON des variables configurables
  downloadCount  Int      @default(0)

  createdAt      DateTime @default(now())

  @@unique([packageId, version])
  @@map("package_versions")
}

model PackageStar {
  id        String   @id @default(uuid())
  userId    String
  packageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, packageId])
  @@map("package_stars")
}

model PackageCollaborator {
  id        String   @id @default(uuid())
  packageId String
  userId    String
  role      String   @default("write") // "read", "write", "admin"
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([packageId, userId])
  @@map("package_collaborators")
}

model PackageWebhook {
  id        String   @id @default(uuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  url       String
  secret    String?
  events    String[] // ["push", "release", "delete"]
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())

  @@map("package_webhooks")
}

// -----------------------------------------------------------------------------
// 3. MONÉTISATION DES QUOTAS R2 & SOUTIENS (Stripe / Paystack)
// -----------------------------------------------------------------------------

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 UserTier
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

model PaymentTransaction {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierName   String
  amount     Int      // Montant en centimes (500 = 5.00 €, 2000 = 20.00 €)
  currency   String   @default("EUR")
  status     String   @default("paid") // "paid", "refunded", "failed"
  externalId String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("payment_transactions")
}

// -----------------------------------------------------------------------------
// 4. ADMINISTRATION & ÉQUIPE
// -----------------------------------------------------------------------------

model AdminInvite {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      AdminRole @default(ADMINISTRATOR)
  token     String    @unique
  accepted  Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@map("admin_invites")
}

// -----------------------------------------------------------------------------
// 5. ALERTES & INTÉGRATIONS EXTERNES (Discord & Telegram)
// -----------------------------------------------------------------------------

model AlertChannel {
  id          String   @id @default(uuid())
  type        String   // "telegram", "discord"
  name        String
  isEnabled   Boolean  @default(false)
  target      String   // Bot token ou Webhook URL
  extraTarget String?  // Chat ID Telegram
  triggers    Json     // Configuration des déclencheurs

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("alert_channels")
}

// -----------------------------------------------------------------------------
// 6. NOTIFICATIONS, ACTIVITÉ & TÉLÉMÉTRIE DU REGISTRE
// -----------------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   // "publication", "pull", "financement", "trafic", "securite"
  title     String
  message   String   @db.Text
  level     String   @default("info")
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String   // "cli", "android", "web"
  action     String   @db.Text
  status     String   @default("success")
  durationMs Int?
  ipAddress  String?
  deviceInfo String?

  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}

model DailyMetric {
  id             String   @id @default(uuid())
  date           DateTime @unique @db.Date
  pullsCount     Int      @default(0)
  signupsCount   Int      @default(0)
  bandwidthBytes BigInt   @default(0)

  @@map("daily_metrics")
}

// -----------------------------------------------------------------------------
// 7. PARAMÈTRES SYSTÈME DU HUB
// -----------------------------------------------------------------------------

model SystemSetting {
  key         String   @id // ex: "maintenance_mode", "max_package_size_bytes"
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
